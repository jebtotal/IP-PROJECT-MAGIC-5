# Copy to .env and fill in locally. Never commit .env or real credentials.
SUPABASE_URL=
SUPABASE_KEY=
FLASK_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
MAIL_SERVER=
MAIL_DEFAULT_SENDER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=true

# Direct PostgreSQL URLs used only by the local backup/restore scripts.
# Use a database password, not a Supabase publishable or service-role key.
# DATABASE_URL is the backup source and also protects against same-database restore.
# RESTORE_DATABASE_URL must point to a separate, pre-created scratch/restore database.
DATABASE_URL=
RESTORE_DATABASE_URL=
